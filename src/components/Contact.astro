---
import { resume } from '../lib/resume';

const { email, socials } = resume.basics;
---

<section class="section contact" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 id="contact-title">Let's talk</h2>
    <p class="lede measure muted">
      Hiring for a product role, or want to compare notes on building products? I'd like to hear from you.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href={`mailto:${email}`}>Email me</a>
      {socials.map((s) => <a class="btn" href={s.url} rel="me">{s.label}</a>)}
    </div>
  </div>
</section>

<style>
  .contact h2 { font-size: var(--step-3); }
</style>
