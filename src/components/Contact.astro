---
import { resume } from '../lib/resume';

const { email, socials } = resume.basics;
---

<section class="contact" aria-labelledby="contact-title">
  <div class="wrap row">
    <div>
      <h2 id="contact-title">Let's build something.</h2>
      <p>Open to senior product roles.</p>
    </div>
    <div class="actions">
      <a class="btn btn-mustard" href={`mailto:${email}`}><i class="ti ti-mail" aria-hidden="true"></i>Email me</a>
      {socials.map((s) => (
        <a class="btn btn-light" href={s.url} rel="me"><i class={`ti ti-brand-${s.label.toLowerCase()}`} aria-hidden="true"></i>{s.label}</a>
      ))}
    </div>
  </div>
</section>

<style>
  .contact { background: var(--violet); color: #fff; }
  .row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: var(--space-l); }
  h2 { color: #fff; margin: 0; }
  p { margin: 0.4rem 0 0; color: var(--lav-300); }
</style>
