---
import { url } from '../lib/site';

interface Props {
  images: { src: string; alt: string; caption?: string }[];
  note?: string;
}

const { images, note } = Astro.props;
---

{note && <p class="note muted">{note}</p>}

<ul class="gallery">
  {images.map((img) => (
    <li>
      <figure>
        <a href={url(`images/${img.src}`)}>
          <img src={url(`images/${img.src}`)} alt={img.alt} loading="lazy" />
        </a>
        {img.caption && <figcaption>{img.caption}</figcaption>}
      </figure>
    </li>
  ))}
</ul>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-s);
    margin-block: var(--space-m);
    padding: 0;
    list-style: none;
  }
  .note { margin: var(--space-m) 0 calc(-1 * var(--space-s)); font-size: var(--step--1); }
  figure { margin: 0; }
  img { width: 100%; border: 1px solid var(--line); border-radius: var(--radius); }
  figcaption { margin-top: 0.5rem; font-size: var(--step--1); color: var(--slate); }
</style>
