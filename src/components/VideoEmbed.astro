---
import { videoEmbedUrl } from '../lib/site';

interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
const embed = videoEmbedUrl(src);
---

{embed ? (
  <div class="video" data-video>
    <button type="button" data-src={embed} data-title={title}>
      <span class="play" aria-hidden="true"></span>
      <span>Play video<span class="visually-hidden">: {title}</span></span>
    </button>
  </div>
) : (
  <p><a href={src}>Watch the video</a></p>
)}

<script>
  // Load the third-party player only when someone asks for it.
  document.querySelectorAll<HTMLElement>('[data-video] button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = btn.dataset.src!;
      iframe.title = btn.dataset.title!;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .video {
    aspect-ratio: 16 / 9;
    margin-block: var(--space-m);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--ink);
  }
  .video button, .video :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
  .video button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background: var(--ink);
    color: var(--paper);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .play {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--mustard);
    clip-path: circle(50%);
    position: relative;
  }
  .play::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0.8rem 0 0.8rem 1.35rem;
    border-color: transparent transparent transparent var(--mustard-ink);
    transform: translateX(0.2rem);
  }
  .video button:hover .play { transform: scale(1.06); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
