---
import { typeLabel, url, type WorkEntry } from '../lib/site';

interface Props {
  entry: WorkEntry;
  headingLevel?: 'h2' | 'h3';
}

const { entry, headingLevel: Heading = 'h3' } = Astro.props;
const { title, type, kind, icon, tone, impact, demo, video } = entry.data;
const href = url(`work/${entry.id}/`);
---

{demo || video ? (
  <article class="tile has-ctas">
    <div class:list={['art', tone]} aria-hidden="true">
      <i class={`ti ti-${icon}`}></i>
    </div>
    <div class="txt">
      <span class="kind">{kind ?? typeLabel(type)}</span>
      <Heading class="title">{title}</Heading>
      {impact && <span class="impact">{impact}</span>}
      <div class="ctas">
        {demo && <a class="cta cta-try" href={url(demo)}><i class="ti ti-player-play" aria-hidden="true"></i>Try me<span class="visually-hidden">: {title} demo</span></a>}
        {video && <a class="cta" href={`${href}#video`}><i class="ti ti-video" aria-hidden="true"></i>Watch video<span class="visually-hidden">: {title}</span></a>}
        {demo && <a class="cta" href={href}><i class="ti ti-route" aria-hidden="true"></i>Show the flow<span class="visually-hidden">: {title}</span></a>}
      </div>
    </div>
  </article>
) : (
  <a class="tile" href={href}>
    <div class:list={['art', tone]}>
      <i class={`ti ti-${icon}`} aria-hidden="true"></i>
      <span class="go" aria-hidden="true"><i class="ti ti-arrow-up-right"></i></span>
    </div>
    <div class="txt">
      <span class="kind">{kind ?? typeLabel(type)}</span>
      <Heading class="title">{title}</Heading>
      {impact && <span class="impact">{impact}</span>}
    </div>
  </a>
)}

<style>
  .has-ctas .txt { display: flex; flex-direction: column; flex: 1; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: auto; padding-top: 0.9rem; }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 40px;
    padding: 0 0.9rem;
    border: 1.5px solid var(--violet);
    border-radius: 999px;
    color: var(--violet);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .cta:hover { background: var(--lav-100); color: var(--violet); }
  .cta-try { border-color: var(--mustard); background: var(--mustard); color: var(--mustard-ink); }
  .cta-try:hover { background: #f0c455; color: var(--mustard-ink); }
  .tile {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: transform 0.25s, border-color 0.25s;
  }
  .tile:hover { transform: translateY(-6px); border-color: var(--lav-500); }
  .art { position: relative; display: flex; align-items: center; justify-content: center; height: 150px; font-size: 3.25rem; }
  .art.lavender { background: var(--lav-100); color: var(--violet); }
  .art.mustard { background: var(--mustard-50); color: #7a5506; }
  .go {
    position: absolute;
    top: 14px;
    right: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #fff;
    color: var(--violet);
    font-size: 1.1rem;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.25s, transform 0.25s;
  }
  .tile:hover .go, .tile:focus-visible .go { opacity: 1; transform: scale(1); }
  .txt { padding: 1rem 1.15rem 1.25rem; }
  .kind { font-size: var(--step--1); font-weight: 600; color: var(--lav-500); }
  .title { margin: 0.2rem 0 0.35rem; font-size: 1.25rem; line-height: 1.15; }
  .impact { font-size: 0.9375rem; color: var(--slate); }
  @media (max-width: 40rem) {
    .art { height: 110px; font-size: 2.5rem; }
    .title { font-size: 1.05rem; }
  }
</style>
