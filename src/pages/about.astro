---
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
import { resume, yearOf } from '../lib/resume';
import { url } from '../lib/site';

const { about, basics, education } = resume;
// Oldest first, so the path reads left to right
const studies = education
  .slice()
  .sort((a, b) => Number(yearOf(a.end)) - Number(yearOf(b.end)))
  .map((e) => ({
    ...e,
    icon: /mba|master/i.test(e.degree) ? 'briefcase-2' : 'cpu',
    years: [yearOf(e.start), yearOf(e.end)].filter(Boolean).join(' – '),
    note: e.timeline?.highlight,
  }));
---

<BaseLayout title="About" description={about[0]}>
  <div class="wrap">
    <section class="intro">
      <div class="text">
        <span class="chip chip-lav"><i class="ti ti-user" aria-hidden="true"></i>About me</span>
        <h1>Builder at heart, product manager by trade.</h1>
        {about.map((p, i) => <p class:list={{ lede: i === 0 }}>{p}</p>)}
      </div>
      {basics.photo && (
        <div class="photo" aria-hidden="true">
          <div class="sun"></div>
          <div class="portrait"><img src={url(basics.photo)} alt="" width="640" height="800" /></div>
        </div>
      )}
    </section>
  </div>

  <section class="section tint" aria-labelledby="edu-title">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="ico" aria-hidden="true"><i class="ti ti-school"></i></span>
        <h2 id="edu-title">Education</h2>
        <p class="sub">From engineering to the business of building products.</p>
      </div>
      <ol class="path">
        {studies.map((e, i) => (
          <li class="degree reveal">
            <span class="step" aria-hidden="true">{e.years}</span>
            <div class="card">
              <span class="icon" aria-hidden="true"><i class={`ti ti-${e.icon}`}></i></span>
              <div>
                <h3>{e.degree}</h3>
                <p class="school">{e.school}</p>
                {e.note && <p class="note"><i class="ti ti-sparkles" aria-hidden="true"></i>{e.note}</p>}
              </div>
            </div>
            {i < studies.length - 1 && <span class="arrow" aria-hidden="true"><i class="ti ti-arrow-right"></i></span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="bring-title">
    <div class="wrap bring reveal">
      <div>
        <h2 id="bring-title">What I bring</h2>
        <ul class="chips">
          {basics.focus.map((f) => <li class="chip chip-outline"><i class={`ti ti-${f.icon}`} aria-hidden="true"></i>{f.label}</li>)}
        </ul>
      </div>
      <a class="more" href={url('experience/#skills')}>All skills <i class="ti ti-arrow-right" aria-hidden="true"></i></a>
    </div>
  </section>

  <Contact />
</BaseLayout>

<style>
  .intro { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--space-l); align-items: center; padding-block: var(--space-l); }
  h1 { margin: 1rem 0 1.25rem; font-size: var(--step-3); max-width: 18ch; }
  .text p { max-width: 60ch; }
  .text .lede { color: var(--violet); }

  .photo { position: relative; aspect-ratio: 4 / 5; max-width: 360px; justify-self: center; width: 100%; }
  .sun { position: absolute; inset: 8% 4% auto auto; width: 78%; aspect-ratio: 1; border-radius: 50%; background: var(--mustard); }
  .portrait {
    position: absolute;
    inset: 14% 10% 0 6%;
    overflow: hidden;
    border: 6px solid #fff;
    border-radius: 999px 999px 18px 18px;
    background: var(--lav-200);
  }
  .portrait img { width: 100%; height: 100%; object-fit: cover; object-position: top; }

  /* Education as a two-step path */
  .path { display: grid; grid-template-columns: repeat(2, 1fr); gap: 3rem; margin: 0; padding: 0; list-style: none; }
  .degree { position: relative; display: flex; flex-direction: column; gap: 0.6rem; }
  .step { align-self: flex-start; padding: 3px 12px; border-radius: 999px; background: var(--violet); color: #fff; font-size: var(--step--1); font-weight: 600; font-variant-numeric: tabular-nums; }
  .card { flex: 1; display: flex; gap: 1rem; padding: 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .icon { display: inline-flex; flex: none; align-items: center; justify-content: center; width: 52px; height: 52px; border-radius: 16px; background: var(--lav-100); color: var(--violet); font-size: 1.6rem; }
  .card h3 { margin: 0 0 0.25rem; font-size: 1.25rem; }
  .school { margin: 0; color: var(--slate); }
  .note { display: flex; gap: 0.4rem; align-items: center; margin: 0.75rem 0 0; font-size: var(--step--1); color: var(--violet); }
  .note i { color: var(--ochre); }
  .arrow {
    position: absolute;
    top: calc(50% + 0.9rem);
    right: -2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--mustard);
    color: var(--mustard-ink);
    transform: translateY(-50%);
  }

  .bring { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem 2rem; }
  .bring h2 { margin-bottom: 1rem; font-size: var(--step-2); }
  .bring .chips { max-width: 46rem; }

  @media (max-width: 52rem) {
    .intro { grid-template-columns: 1fr; gap: 1.5rem; }
    .photo { order: -1; max-width: 240px; }
    .path { grid-template-columns: 1fr; gap: 2.5rem; }
    .arrow { top: auto; bottom: -2.2rem; right: auto; left: 1.5rem; transform: rotate(90deg); }
  }
</style>
