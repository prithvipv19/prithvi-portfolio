---
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import Contact from '../components/Contact.astro';
import { resume, toYear, tenure } from '../lib/resume';
import { url } from '../lib/site';

const { basics, experience, skills, certifications } = resume;
// The download button appears when public/resume.pdf exists.
const hasPdf = existsSync('public/resume.pdf');
const range = (start?: string | number, end?: string | number) => [start, end].filter(Boolean).join(' – ');
const skillIcons: Record<string, string> = {
  Domains: 'world',
  'Product strategy': 'bulb',
  'Delivery & growth': 'rocket',
  'AI & tools': 'sparkles',
};
const sections = [
  { id: 'work', label: 'Work experience', icon: 'briefcase', count: experience.length },
  { id: 'skills', label: 'Skills', icon: 'tools', count: skills.reduce((n, s) => n + s.items.length, 0) },
  ...(certifications.length ? [{ id: 'certifications', label: 'Certifications', icon: 'certificate', count: certifications.length }] : []),
];
---

<BaseLayout title="Experience" description={`Experience of ${basics.name}, ${basics.headline}.`}>
  <div class="wrap">
    <header class="page-head head">
      <div>
        <h1>Experience</h1>
        <p class="lede">{basics.years} building products in supply chain, HR, data platforms and AI.</p>
      </div>
      <div class="actions no-print">
        {hasPdf && <a class="btn btn-primary" href={url('resume.pdf')} download><i class="ti ti-download" aria-hidden="true"></i>Download resume</a>}
        <button class="btn btn-ghost" type="button" data-print><i class="ti ti-printer" aria-hidden="true"></i>Print</button>
      </div>
    </header>
  </div>

  <nav class="jump no-print" aria-label="On this page">
    <div class="wrap">
      <ul>
        {sections.map((s, i) => (
          <li>
            <a href={`#${s.id}`} aria-current={i === 0 ? 'true' : undefined}>
              <i class={`ti ti-${s.icon}`} aria-hidden="true"></i>{s.label}<span>{s.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <section class="section block" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="ico" aria-hidden="true"><i class="ti ti-briefcase"></i></span>
        <h2 id="work-title">Work experience</h2>
        <span class="count">{experience.length} roles</span>
      </div>
      <ol class="roles">
        {experience.map((job) => (
          <li class="role reveal">
            <div class="logo">
              {job.logo ? <img src={url(job.logo)} alt={`${job.company} logo`} /> : <i class={`ti ti-${job.icon ?? 'briefcase'}`} aria-hidden="true"></i>}
            </div>
            <div>
              <div class="top">
                <div>
                  <h3>{job.role}</h3>
                  <p class="co">{job.company}{job.location && `, ${job.location}`}</p>
                </div>
                <p class="when">
                  <span>{range(job.start, job.end)}</span>
                  <span class="yrs">{tenure(toYear(job.end) - toYear(job.start))}</span>
                </p>
              </div>
              {job.domain && <span class="chip chip-mustard"><i class={`ti ti-${job.icon}`} aria-hidden="true"></i>{job.domain}</span>}
              <ul class="hl">{job.highlights.map((h) => <li>{h}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section block tint" id="skills" aria-labelledby="skills-title">
    <div class="wrap">
      <div class="sec-title reveal">
        <span class="ico" aria-hidden="true"><i class="ti ti-tools"></i></span>
        <h2 id="skills-title">Skills</h2>
        <span class="count">{skills.length} areas</span>
      </div>
      <div class="skill-grid">
        {skills.map((s) => (
          <div class="skill reveal">
            <h3><span aria-hidden="true"><i class={`ti ti-${skillIcons[s.group] ?? 'point'}`}></i></span>{s.group}</h3>
            <ul class="chips">{s.items.map((item) => <li class="chip chip-outline">{item}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {certifications.length > 0 && (
    <section class="section block" id="certifications" aria-labelledby="cert-title">
      <div class="wrap">
        <div class="sec-title reveal">
          <span class="ico" aria-hidden="true"><i class="ti ti-certificate"></i></span>
          <h2 id="cert-title">Certifications</h2>
          <span class="count">{certifications.length}</span>
        </div>
        <ul class="certs">
          {certifications.map((c) => (
            <li class="cert reveal">
              <span class="badge" aria-hidden="true"><i class="ti ti-rosette-discount-check"></i></span>
              <div>
                <h3>{c.name}</h3>
                <p>{c.issuer}<span class="dot" aria-hidden="true"></span>{c.year}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <div class="no-print"><Contact /></div>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());

  // Highlight the section you're reading in the sticky bar
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.jump a')];
  const targets = links.map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!)!);
  const mark = (id: string) => links.forEach((a) => (a.getAttribute('href') === `#${id}` ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
  const spy = new IntersectionObserver(
    (entries) => entries.filter((e) => e.isIntersecting).forEach((e) => mark(e.target.id)),
    { rootMargin: '-35% 0px -60% 0px' }
  );
  targets.forEach((t) => t && spy.observe(t));
</script>

<style>
  .head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-m); }

  /* Sticky jump bar */
  .jump { position: sticky; top: 0; z-index: 15; background: rgb(255 255 255 / 0.92); backdrop-filter: blur(8px); border-block: 1px solid var(--line); }
  .jump ul { display: flex; gap: 0.5rem; margin: 0; padding: 0.6rem 0; list-style: none; overflow-x: auto; scrollbar-width: none; }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    font-weight: 600;
    color: var(--violet);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s, color 0.2s;
  }
  .jump a i { color: var(--ochre); }
  .jump a span { padding: 0 7px; border-radius: 999px; background: var(--lav-100); font-size: 0.75rem; }
  .jump a:hover { background: var(--lav-50); }
  .jump a[aria-current] { background: var(--violet); color: #fff; }
  .jump a[aria-current] i { color: var(--mustard); }
  .jump a[aria-current] span { background: rgb(255 255 255 / 0.18); }
  .block { scroll-margin-top: 70px; }

  /* Roles */
  .roles { margin: 0; padding: 0; list-style: none; }
  .role {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
    margin-bottom: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
  }
  .logo { display: flex; align-items: center; justify-content: center; height: 72px; padding: 12px; border-radius: 16px; background: var(--lav-50); color: var(--violet); font-size: 1.8rem; }
  .logo img { height: 32px; width: auto; max-width: 100%; object-fit: contain; }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1rem; margin-bottom: 0.6rem; }
  .role h3 { margin: 0; font-size: 1.3rem; }
  .co { margin: 0.1rem 0 0; color: var(--slate); }
  .when { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; margin: 0; font-size: var(--step--1); color: var(--lav-500); font-variant-numeric: tabular-nums; }
  .yrs { padding: 2px 10px; border-radius: 999px; background: var(--lav-100); font-weight: 600; color: var(--violet); }
  .hl { margin: 0.9rem 0 0; padding-left: 1.2rem; }
  .hl li + li { margin-top: 0.35rem; }
  .hl li::marker { color: var(--ochre); }

  /* Skills */
  .skill-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .skill { padding: 1.4rem 1.5rem; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .skill h3 { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1rem; }
  .skill h3 span { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 11px; background: var(--lav-100); color: var(--violet); font-size: 1.15rem; }

  /* Certifications */
  .certs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: 1.25rem; margin: 0; padding: 0; list-style: none; }
  .cert {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-left: 5px solid var(--mustard);
    border-radius: var(--radius);
    background: #fff;
  }
  .badge { display: inline-flex; flex: none; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 50%; background: var(--mustard-50); color: var(--ochre); font-size: 1.6rem; }
  .cert h3 { margin: 0 0 0.35rem; font-size: 1.1rem; line-height: 1.3; }
  .cert p { display: flex; align-items: center; gap: 0.5rem; margin: 0; font-size: var(--step--1); color: var(--slate); }
  .cert .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--lav-300); }

  @media (max-width: 44rem) {
    .role { grid-template-columns: 1fr; gap: 1rem; padding: 1.25rem; }
    .logo { justify-content: flex-start; width: fit-content; min-width: 120px; height: 60px; }
    .when { flex-direction: row; align-items: center; }
    .skill-grid { grid-template-columns: 1fr; }
    .sec-title .ico { width: 44px; height: 44px; font-size: 1.35rem; }
  }

  @media print {
    :global(.site-header), :global(.site-footer), :global(.skip-link), .no-print { display: none !important; }
    :global(body) { font-size: 10.5pt; }
    :global(.js .reveal) { opacity: 1 !important; transform: none !important; }
    :global(.section) { padding: 0 0 12pt; background: none; }
    h1 { font-size: 22pt; }
    .sec-title .ico, .sec-title .count { display: none; }
    .role, .skill, .cert { break-inside: avoid; }
    .role { border: 0; border-bottom: 1px solid #ddd; border-radius: 0; padding: 8pt 0; }
    a { color: #000; text-decoration: none; }
  }
</style>
