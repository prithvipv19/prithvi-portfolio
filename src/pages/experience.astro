---
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import Contact from '../components/Contact.astro';
import { resume, toYear, tenure } from '../lib/resume';
import { url } from '../lib/site';

const { basics, experience, education, skills, certifications } = resume;
// The download button appears when public/resume.pdf exists.
const hasPdf = existsSync('public/resume.pdf');
const range = (start?: string | number, end?: string | number) => [start, end].filter(Boolean).join(' – ');
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
---

<BaseLayout title="Experience" description={`Experience of ${basics.name}, ${basics.headline}.`}>
  <div class="wrap">
    <header class="page-head head">
      <div>
        <h1>Experience</h1>
        <p class="lede">{basics.years} building products in supply chain, HR, data platforms and AI.</p>
      </div>
      <div class="actions no-print">
        {hasPdf && <a class="btn btn-primary" href={url('resume.pdf')} download><i class="ti ti-download" aria-hidden="true"></i>Download resume</a>}
        <button class="btn btn-ghost" type="button" data-print><i class="ti ti-printer" aria-hidden="true"></i>Print</button>
      </div>
    </header>
  </div>

  <section class="section tint no-print" aria-label="Career timeline">
    <div class="wrap"><CareerTimeline /></div>
  </section>

  <section class="section" aria-labelledby="roles-title">
    <div class="wrap">
      <h2 id="roles-title" class="reveal">Roles in detail</h2>
      <ol class="roles">
        {experience.map((job) => (
          <li class="role reveal">
            <div class="logo">
              {job.logo ? <img src={url(job.logo)} alt={`${job.company} logo`} /> : <i class={`ti ti-${job.icon ?? 'briefcase'}`} aria-hidden="true"></i>}
            </div>
            <div>
              <div class="top">
                <div>
                  <h3>{job.role}</h3>
                  <p class="co">{job.company}{job.location && `, ${job.location}`}</p>
                </div>
                <p class="when">
                  <span>{range(job.start, job.end)}</span>
                  <span class="yrs">{tenure(toYear(job.end) - toYear(job.start))}</span>
                </p>
              </div>
              {job.domain && <span class="chip chip-mustard"><i class={`ti ti-${job.icon}`} aria-hidden="true"></i>{job.domain}</span>}
              <ul class="hl">{job.highlights.map((h) => <li>{h}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>

      <div class="drops">
        <details class="drop">
          <summary>
            <i class="ti ti-tools" aria-hidden="true"></i><h2>Skills</h2>
            <span class="count">{plural(skills.length, 'group')}</span>
          </summary>
          <dl class="skills">
            {skills.map((s) => (
              <div>
                <dt>{s.group}</dt>
                <dd><ul class="chips">{s.items.map((item) => <li class="chip chip-outline">{item}</li>)}</ul></dd>
              </div>
            ))}
          </dl>
        </details>

        <details class="drop">
          <summary>
            <i class="ti ti-school" aria-hidden="true"></i><h2>Education</h2>
            <span class="count">{plural(education.length, 'degree')}</span>
          </summary>
          <ul class="plain">
            {education.map((e) => (
              <li><strong>{e.degree}</strong><span>{e.school}</span><span class="muted">{range(e.start, e.end)}</span></li>
            ))}
          </ul>
        </details>

        {certifications.length > 0 && (
          <details class="drop">
            <summary>
              <i class="ti ti-certificate" aria-hidden="true"></i><h2>Certifications</h2>
              <span class="count">{plural(certifications.length, 'certificate')}</span>
            </summary>
            <ul class="plain">
              {certifications.map((c) => (
                <li><strong>{c.name}</strong><span>{c.issuer}</span><span class="muted">{c.year}</span></li>
              ))}
            </ul>
          </details>
        )}
      </div>
    </div>
  </section>

  <div class="no-print"><Contact /></div>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());

  // Expand every dropdown while printing, then restore what the reader had open.
  const drops = [...document.querySelectorAll<HTMLDetailsElement>('details.drop')];
  let wasOpen: boolean[] = [];
  window.addEventListener('beforeprint', () => {
    wasOpen = drops.map((d) => d.open);
    drops.forEach((d) => (d.open = true));
  });
  window.addEventListener('afterprint', () => drops.forEach((d, i) => (d.open = wasOpen[i])));
</script>

<style>
  .head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: var(--space-m); }

  .roles { margin: 0 0 var(--space-l); padding: 0; list-style: none; }
  .role {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
    margin-bottom: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
  }
  .logo { display: flex; align-items: center; justify-content: center; height: 72px; padding: 12px; border-radius: 16px; background: var(--lav-50); color: var(--violet); font-size: 1.8rem; }
  .logo img { height: 32px; width: auto; max-width: 100%; object-fit: contain; }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1rem; margin-bottom: 0.6rem; }
  .role h3 { margin: 0; font-size: 1.3rem; }
  .co { margin: 0.1rem 0 0; color: var(--slate); }
  .when { display: flex; flex-direction: column; align-items: flex-end; gap: 0.3rem; margin: 0; font-size: var(--step--1); color: var(--lav-500); font-variant-numeric: tabular-nums; }
  .yrs { padding: 2px 10px; border-radius: 999px; background: var(--lav-100); font-weight: 600; color: var(--violet); }
  .hl { margin: 0.9rem 0 0; padding-left: 1.2rem; }
  .hl li + li { margin-top: 0.35rem; }
  .hl li::marker { color: var(--ochre); }

  .drops { border-top: 1px solid var(--line); }
  .drop { border-bottom: 1px solid var(--line); }
  .drop summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding-block: 1.1rem;
    cursor: pointer;
    list-style: none;
  }
  .drop summary::-webkit-details-marker { display: none; }
  .drop summary > i { font-size: 1.5rem; color: var(--ochre); }
  .drop summary h2 { margin: 0; font-size: var(--step-2); }
  .drop summary::after {
    content: '';
    flex: none;
    width: 0.65rem;
    height: 0.65rem;
    margin-left: auto;
    border-right: 2.5px solid var(--violet);
    border-bottom: 2.5px solid var(--violet);
    transform: translateY(-25%) rotate(45deg);
    transition: transform 0.15s ease;
  }
  .drop[open] summary::after { transform: translateY(25%) rotate(-135deg); }
  .count { font-size: var(--step--1); color: var(--lav-500); }
  .drop > :not(summary) { margin-bottom: var(--space-m); }
  .skills { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-m); }
  dt { margin-bottom: 0.5rem; font-weight: 600; }
  dd { margin: 0; }
  .plain { margin: 0; padding: 0; list-style: none; }
  .plain li { display: flex; flex-direction: column; }
  .plain li + li { margin-top: 1rem; }

  @media (max-width: 44rem) {
    .role { grid-template-columns: 1fr; gap: 1rem; padding: 1.25rem; }
    .logo { justify-content: flex-start; width: fit-content; min-width: 120px; height: 60px; }
    .when { align-items: flex-start; flex-direction: row; align-items: center; }
    .skills { grid-template-columns: 1fr; }
  }

  @media print {
    :global(.site-header), :global(.site-footer), :global(.skip-link), .no-print { display: none !important; }
    :global(body) { font-size: 10.5pt; }
    :global(.js .reveal) { opacity: 1 !important; transform: none !important; }
    :global(.section) { padding: 0; }
    h1 { font-size: 22pt; }
    .role { break-inside: avoid; border: 0; border-bottom: 1px solid #ddd; border-radius: 0; padding: 8pt 0; }
    .drop summary::after, .count, .drop summary > i { display: none; }
    .drop { break-inside: avoid; }
    a { color: #000; text-decoration: none; }
  }
</style>
