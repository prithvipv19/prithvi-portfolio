---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import Contact from '../components/Contact.astro';
import { resume } from '../lib/resume';
import { getWork, url } from '../lib/site';

const { name, shortName = name, headline, intro } = resume.basics;
const featured = (await getWork()).filter((w) => w.data.featured).slice(0, 4);
---

<BaseLayout>
  <section class="hero">
    <div class="wrap">
      <p class="hello">Hi, I'm {shortName}, a {headline.toLowerCase()}.</p>
      <h1>I find the problems worth solving, then help teams ship the fix.</h1>
      <p class="lede measure muted">{intro}</p>
      <div class="actions">
        <a class="btn btn-primary" href={url('work/')}>See my work</a>
        <a class="btn" href={url('experience/')}>See my experience</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="featured-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="featured-title">Selected work</h2>
        <a href={url('work/')}>All work</a>
      </div>
      <div class="rows">
        {featured.map((entry) => <WorkCard entry={entry} variant="row" />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="about-title">
    <div class="wrap measure">
      <h2 id="about-title">A bit about me</h2>
      <p class="lede">{resume.about[0]}</p>
      <a href={url('about/')}>More about me</a>
    </div>
  </section>

  <Contact />
</BaseLayout>

<style>
  .hero { padding-block: var(--space-xl) var(--space-l); }
  .hello { font-weight: 700; margin-bottom: 0.75rem; }
  h1 { font-size: var(--step-4); font-weight: 800; letter-spacing: -0.035em; max-width: 16ch; }
  .lede { margin-bottom: var(--space-m); }

  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1rem; }
  .section-head a { font-weight: 700; }
  .rows { border-bottom: 1px solid var(--line); }
</style>
