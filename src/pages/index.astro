---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import Contact from '../components/Contact.astro';
import { resume } from '../lib/resume';
import { getWork, url } from '../lib/site';

const { name, headline, intro, now } = resume.basics;
const featured = (await getWork()).filter((w) => w.data.featured).slice(0, 4);
---

<BaseLayout>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="hello">Hi, I'm {name}, a {headline.toLowerCase()}.</p>
        <h1>I find the problems worth solving, then help teams ship the fix.</h1>
        <p class="lede measure muted">{intro}</p>
        <div class="actions">
          <a class="btn btn-primary" href={url('work/')}>See my work</a>
          <a class="btn" href={url('resume/')}>Read my resume</a>
        </div>
      </div>
      {now && (
        <aside class="note" aria-label="What I'm working on right now">
          <p class="note-label">Right now</p>
          <p class="note-text">{now}</p>
        </aside>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="featured-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="featured-title">Selected work</h2>
        <a href={url('work/')}>All work</a>
      </div>
      <div class="rows">
        {featured.map((entry) => <WorkCard entry={entry} variant="row" />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="about-title">
    <div class="wrap measure">
      <h2 id="about-title">A bit about me</h2>
      <p class="lede">{resume.about[0]}</p>
      <a href={url('about/')}>More about me</a>
    </div>
  </section>

  <Contact />
</BaseLayout>

<style>
  .hero { padding-block: var(--space-xl) var(--space-l); }
  .hero-grid { display: grid; gap: var(--space-l); align-items: center; }
  @media (min-width: 56rem) {
    .hero-grid { grid-template-columns: minmax(0, 1.75fr) minmax(15rem, 1fr); }
  }
  .hello { font-weight: 700; margin-bottom: 0.75rem; }
  h1 { font-size: var(--step-4); font-weight: 800; letter-spacing: -0.035em; max-width: 16ch; }
  .lede { margin-bottom: var(--space-m); }

  /* The sticky note: the page's one bold element */
  .note {
    justify-self: start;
    max-width: 19rem;
    padding: 1.5rem 1.5rem 2rem;
    background: var(--note);
    color: var(--note-ink);
    border-radius: 2px 2px 18px 2px;
    box-shadow: 0 1px 1px rgb(42 34 8 / 0.12), 0 12px 24px -12px rgb(42 34 8 / 0.35);
    transform: rotate(-2.5deg);
    animation: stick 600ms cubic-bezier(0.2, 0.8, 0.2, 1.2) 200ms both;
  }
  @media (min-width: 56rem) { .note { justify-self: center; } }
  .note-label { margin: 0 0 0.5rem; font-weight: 700; }
  .note-text { margin: 0; font-family: var(--font-display); font-size: var(--step-1); font-weight: 600; line-height: 1.3; }
  @keyframes stick {
    from { opacity: 0; transform: translateY(-12px) rotate(4deg); }
  }

  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1rem; }
  .section-head a { font-weight: 700; }
  .rows { border-bottom: 1px solid var(--line); }
</style>
