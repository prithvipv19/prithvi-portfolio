---
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resume } from '../lib/resume';
import { url } from '../lib/site';

const { basics, experience, education, skills, certifications } = resume;
// The download button appears once you add public/resume.pdf.
const hasPdf = existsSync('public/resume.pdf');
const range = (start?: string | number, end?: string | number) => [start, end].filter(Boolean).join('–');
---

<BaseLayout title="Resume" description={`Resume of ${basics.name}, ${basics.headline}.`}>
  <div class="section">
    <div class="wrap resume">
      <header class="head">
        <div>
          <h1>{basics.name}</h1>
          <p class="lede">{basics.headline}{basics.location && <span class="muted">, {basics.location}</span>}</p>
          <ul class="contact">
            <li><a href={`mailto:${basics.email}`}>{basics.email}</a></li>
            {basics.socials.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
          </ul>
        </div>
        <div class="actions no-print">
          {hasPdf && <a class="btn btn-primary" href={url('resume.pdf')} download>Download PDF</a>}
          <button class="btn" type="button" data-print>Print</button>
        </div>
      </header>

      <section aria-labelledby="exp-title">
        <h2 id="exp-title">Experience</h2>
        <ol class="timeline">
          {experience.map((job) => (
            <li>
              <div class="when muted">{range(job.start, job.end)}</div>
              <div>
                <h3>{job.role}, <span class="company">{job.company}</span></h3>
                {job.summary && <p class="muted">{job.summary}</p>}
                <ul>{job.highlights.map((h) => <li>{h}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <div class="split">
        <section aria-labelledby="skills-title">
          <h2 id="skills-title">Skills</h2>
          <dl class="skills">
            {skills.map((s) => (
              <div>
                <dt>{s.group}</dt>
                <dd>{s.items.join(', ')}</dd>
              </div>
            ))}
          </dl>
        </section>

        <div>
          <section aria-labelledby="edu-title">
            <h2 id="edu-title">Education</h2>
            <ul class="plain">
              {education.map((e) => (
                <li><strong>{e.degree}</strong><br />{e.school} <span class="muted">{range(e.start, e.end)}</span></li>
              ))}
            </ul>
          </section>

          {certifications.length > 0 && (
            <section aria-labelledby="cert-title">
              <h2 id="cert-title">Certifications</h2>
              <ul class="plain">
                {certifications.map((c) => (
                  <li><strong>{c.name}</strong><br />{c.issuer} <span class="muted">{c.year}</span></li>
                ))}
              </ul>
            </section>
          )}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  .resume { max-width: 60rem; }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-m);
    padding-bottom: var(--space-m);
    margin-bottom: var(--space-l);
    border-bottom: 1px solid var(--line);
  }
  h1 { font-size: var(--step-4); font-weight: 800; letter-spacing: -0.035em; margin-bottom: 0.15em; }
  .lede { margin-bottom: 0.5rem; }
  .contact { display: flex; flex-wrap: wrap; gap: 0 1.25rem; margin: 0; padding: 0; list-style: none; }
  .contact a { display: inline-flex; align-items: center; min-height: 44px; }
  h2 { font-size: var(--step-2); margin-bottom: var(--space-m); }
  section { margin-bottom: var(--space-l); }

  /* Experience is a real sequence, so it gets a timeline */
  .timeline { margin: 0; padding: 0; list-style: none; }
  .timeline > li {
    position: relative;
    display: grid;
    gap: 0.25rem 2rem;
    padding: 0 0 var(--space-m) 1.5rem;
    border-left: 2px solid var(--line);
  }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 0.4rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--note);
    border: 2px solid var(--paper);
  }
  .timeline > li:last-child { border-left-color: transparent; }
  @media (min-width: 48rem) {
    .timeline > li { grid-template-columns: 8rem minmax(0, 1fr); }
  }
  .when { font-size: var(--step--1); padding-top: 0.2rem; font-variant-numeric: tabular-nums; }
  .company { font-weight: 600; color: var(--slate); }
  .timeline ul { padding-left: 1.2rem; }
  .timeline ul li + li { margin-top: 0.3rem; }

  .split { display: grid; gap: 0 var(--space-l); }
  @media (min-width: 48rem) { .split { grid-template-columns: 1fr 1fr; } }
  .skills > div + div { margin-top: 1rem; }
  dt { font-weight: 700; }
  dd { margin: 0; color: var(--slate); }
  .plain { margin: 0; padding: 0; list-style: none; }
  .plain li + li { margin-top: 1rem; }

  @media print {
    :global(.site-header), :global(.site-footer), :global(.skip-link), .no-print { display: none !important; }
    :global(body) { background: #fff; color: #000; font-size: 11pt; }
    :global(.section) { padding: 0; }
    h1 { font-size: 24pt; }
    h2 { font-size: 14pt; margin-bottom: 8pt; }
    section { margin-bottom: 14pt; break-inside: avoid-page; }
    .timeline > li { grid-template-columns: 7rem 1fr; break-inside: avoid; }
    .split { grid-template-columns: 1fr 1fr; }
    a { color: #000; text-decoration: none; }
  }
</style>
