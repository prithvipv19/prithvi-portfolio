---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkTile from '../../components/WorkTile.astro';
import Contact from '../../components/Contact.astro';
import { getWork, workTypes } from '../../lib/site';

const work = await getWork();
const filters = workTypes
  .map((t) => ({ ...t, count: work.filter((w) => w.data.type === t.id).length }))
  .filter((t) => t.count > 0);
---

<BaseLayout title="Work" description="Products I've helped build and ship, with the outcomes.">
  <div class="wrap">
    <header class="page-head">
      <h1>Work</h1>
      <p class="lede">Products I've helped build and ship, and what changed because of them.</p>
    </header>

    {filters.length > 1 && (
      <div class="filters" role="group" aria-label="Filter work by type">
        <button type="button" data-filter="all" aria-pressed="true">All <span>{work.length}</span></button>
        {filters.map((f) => (
          <button type="button" data-filter={f.id} aria-pressed="false">{f.plural} <span>{f.count}</span></button>
        ))}
      </div>
    )}
    <p class="visually-hidden" aria-live="polite" data-status></p>

    <ul class="grid">
      {work.map((entry) => (
        <li data-type={entry.data.type}><WorkTile entry={entry} headingLevel="h2" /></li>
      ))}
    </ul>
  </div>
  <Contact />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLLIElement>('.grid > li');
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      items.forEach((item) => {
        const match = filter === 'all' || item.dataset.type === filter;
        item.hidden = !match;
        if (match) shown++;
      });
      status.textContent = `Showing ${shown} ${shown === 1 ? 'project' : 'projects'}`;
    })
  );
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; }
  .filters button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--lav-300);
    border-radius: 999px;
    background: #fff;
    color: var(--violet);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }
  .filters span { font-size: var(--step--1); color: var(--lav-500); }
  .filters button[aria-pressed='true'] { background: var(--violet); border-color: var(--violet); color: #fff; }
  .filters button[aria-pressed='true'] span { color: var(--lav-300); }
  /* 1 column on small phones, 2 on phones and tablets, up to 4 on desktop */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 1.1rem;
    margin: 0 0 var(--space-l);
    padding: 0;
    list-style: none;
  }
  .grid > li[hidden] { display: none; }
  @media (max-width: 40rem) { .grid { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; } }
  @media (max-width: 22rem) { .grid { grid-template-columns: 1fr; } }
</style>
