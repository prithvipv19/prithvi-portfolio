---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { defaultPolicy, hhmm } from '../../../lib/overtime-demo';
import { url } from '../../../lib/site';

const steps = [
  { id: 'employee', n: 1, label: 'Apply for OT', who: 'Employee' },
  { id: 'manager', n: 2, label: 'Review & apply for team', who: 'Manager' },
  { id: 'finalize', n: 3, label: 'Finalize for payroll', who: 'HR admin' },
];
const p = defaultPolicy();
const rules = [
  { icon: 'coffee', label: 'Break deducted', value: `${p.breakMin.rest} min on rest days and holidays` },
  { icon: 'hourglass-low', label: 'Minimum to qualify', value: `${p.minMin.regular} min on regular days, ${p.minMin.rest} min otherwise` },
  { icon: 'adjustments', label: 'Rounding', value: `Down to ${p.block}-minute blocks` },
  { icon: 'shield-check', label: 'Caps', value: `${hhmm(p.dailyCapMin)} h a day, ${hhmm(p.monthlyCapMin)} h a month` },
  { icon: 'currency-rupee', label: 'Pay', value: `Basic ÷ 208 h × ${p.multiplier.regular} (× ${p.multiplier.holiday} on holidays)` },
];
---

<BaseLayout title="Overtime demo" description="Try the overtime flow end to end: policy, employee request, manager approval and payroll finalization, on fictional data.">
  <div class="wrap">
    <a class="more back" href={url('work/overtime-module/')}><i class="ti ti-arrow-left" aria-hidden="true"></i> Back to the case study</a>
    <header class="demo-head">
      <h1>Try the overtime flow</h1>
      <p class="lede">Apply for overtime, approve it, and send it to payroll. Each step uses what you did in the last one.</p>
      <ul class="chips">
        <li class="chip chip-mustard"><i class="ti ti-flask" aria-hidden="true"></i>Fictional data</li>
        <li class="chip chip-lav"><i class="ti ti-refresh" aria-hidden="true"></i>Resets when you reload</li>
      </ul>
    </header>

    <div class="ot-demo" id="ot-demo">
      <nav class="steps" aria-label="Demo steps">
        {steps.map((s) => (
          <button type="button" data-view={s.id} aria-pressed={s.id === 'employee' ? 'true' : 'false'}>
            <span class="n" aria-hidden="true">{s.n}</span>
            <span><strong>{s.label}</strong><small>{s.who}</small></span>
          </button>
        ))}
      </nav>

      <section class="card policy" aria-labelledby="policy-title">
        <h2 id="policy-title"><i class="ti ti-file-certificate" aria-hidden="true"></i>{p.name}</h2>
        <dl>
          {rules.map((r) => (
            <div><dt><i class={`ti ti-${r.icon}`} aria-hidden="true"></i>{r.label}</dt><dd>{r.value}</dd></div>
          ))}
        </dl>
      </section>

      <section class="view" data-panel="employee"></section>
      <section class="view" data-panel="manager" hidden></section>
      <section class="view" data-panel="finalize" hidden></section>

      <p class="toast" id="toast" role="status" aria-live="polite"></p>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    clocked, currentMonth, dayTypes, defaultPolicy, eligibleOt, employees, hhmm, hourlyRate,
    managerName, me, monthOf, rupees, seededReversal, seedRequests,
    type DayType, type OtRequest, type Policy,
  } from '../../../lib/overtime-demo';

  const policy: Policy = defaultPolicy();
  let requests: OtRequest[] = seedRequests();
  let nextId = 100;
  let empTab: 'apply' | 'pending' | 'history' = 'apply';
  let mgrTab: 'review' | 'closed' | 'team' = 'review';
  let payMonth = currentMonth;

  const root = document.getElementById('ot-demo')!;
  const panel = (id: string) => root.querySelector<HTMLElement>(`[data-panel="${id}"]`)!;
  const emp = (id: string) => employees.find((e) => e.id === id)!;
  const dayOf = (empId: string, date: string): DayType =>
    clocked.find((c) => c.empId === empId && c.date === date)?.dayType ?? 'regular';
  const dayLabel = (d: DayType) => dayTypes.find((t) => t.id === d)!.label;
  const fmtDate = (iso: string) =>
    new Date(iso + 'T00:00:00Z').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', timeZone: 'UTC' });
  const monthLabel = (m: string) =>
    new Date(m + '-01T00:00:00Z').toLocaleDateString('en-IN', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const active = (r: OtRequest) => r.status === 'pending' || r.status === 'approved';
  const usedThisMonth = (empId: string) =>
    requests.filter((r) => r.empId === empId && active(r) && monthOf(r.date) === currentMonth).reduce((s, r) => s + r.minutes, 0);
  const hasActive = (empId: string, date: string) => requests.some((r) => r.empId === empId && r.date === date && active(r));
  const statusChip = (s: string) => `<span class="st st-${s}">${s[0].toUpperCase() + s.slice(1)}</span>`;

  let toastTimer = 0;
  function toast(msg: string, bad = false) {
    const t = document.getElementById('toast')!;
    t.textContent = msg;
    t.classList.toggle('bad', bad);
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => t.classList.remove('show'), 3200);
  }

  // ---------- Navigation ----------
  function show(view: string) {
    root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
    root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== view));
    render(view);
  }
  root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => show(b.dataset.view!)));

  function render(view: string) {
    if (view === 'employee') renderEmployee();
    if (view === 'manager') renderManager();
    if (view === 'finalize') renderFinalize();
  }

  // ---------- 1. Employee ----------
  function tabs(name: string, current: string, items: [string, string][]) {
    return `<div class="tabs" role="group" aria-label="${name}">${items
      .map(([id, label]) => `<button type="button" data-tab="${id}" aria-pressed="${id === current}">${label}</button>`)
      .join('')}</div>`;
  }

  function renderEmployee() {
    const p = panel('employee');
    const used = usedThisMonth(me);
    const clockedTotal = clocked.filter((c) => c.empId === me && monthOf(c.date) === currentMonth).reduce((s, c) => s + c.extraMin, 0);
    const mine = requests.filter((r) => r.empId === me);
    const pending = mine.filter((r) => r.status === 'pending');
    const history = mine.filter((r) => r.status !== 'pending');
    let body = '';

    if (empTab === 'apply') {
      const rows = clocked
        .filter((c) => c.empId === me && !hasActive(me, c.date))
        .sort((a, b) => a.date.localeCompare(b.date))
        .map((c) => {
          const b = eligibleOt(policy, c.dayType, c.extraMin);
          const ok = b.eligible > 0;
          return `<tr class="${ok ? '' : 'off'}">
            <td><input type="checkbox" data-date="${c.date}" ${ok ? '' : 'disabled'} aria-label="Select ${fmtDate(c.date)}"></td>
            <td>${fmtDate(c.date)}</td><td>${dayLabel(c.dayType)}</td><td>${hhmm(c.extraMin)}</td>
            <td><b>${ok ? hhmm(b.eligible) : '—'}</b>${ok ? '' : '<small>Below minimum</small>'}</td>
            <td><input type="text" data-reason="${c.date}" placeholder="Reason" ${ok ? '' : 'disabled'} aria-label="Reason for ${fmtDate(c.date)}"></td>
          </tr>`;
        })
        .join('');
      body = rows
        ? `<div class="tbl"><table><thead><tr><th scope="col"><span class="visually-hidden">Select</span></th><th scope="col">Date</th><th scope="col">Day type</th><th scope="col">Clocked extra</th><th scope="col">Eligible OT</th><th scope="col">Reason</th></tr></thead><tbody>${rows}</tbody></table></div>
           <label class="field">Remarks (required) <textarea id="emp-remarks" rows="2" placeholder="e.g. Covered the Line 2 backlog"></textarea></label>
           <div class="actions"><button type="button" class="btn btn-primary" data-act="emp-submit"><i class="ti ti-send" aria-hidden="true"></i>Submit to ${managerName}</button></div>`
        : `<p class="empty">Nothing left to apply for this month. Check the Pending tab.</p>`;
    } else {
      const list = empTab === 'pending' ? pending : history;
      body = list.length
        ? `<div class="tbl"><table><thead><tr><th scope="col">Date</th><th scope="col">OT hours</th><th scope="col">Reason</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead><tbody>${list
            .map((r) => `<tr><td>${fmtDate(r.date)}</td><td>${hhmm(r.minutes)}</td><td>${esc(r.reason)}${r.remarks ? `<small>Reviewer: ${esc(r.remarks)}</small>` : ''}</td><td>${statusChip(r.status)}</td>
              <td>${r.status === 'pending' ? `<button type="button" class="link" data-act="withdraw" data-id="${r.id}">Withdraw</button>` : ''}</td></tr>`)
            .join('')}</tbody></table></div>`
        : `<p class="empty">${empTab === 'pending' ? 'No pending requests.' : 'No closed requests yet.'}</p>`;
    }

    p.innerHTML = `
      <p class="hint"><i class="ti ti-user" aria-hidden="true"></i>You're <b>${esc(emp(me).name)}</b> (${esc(emp(me).dept)}). Eligible hours come from attendance and the policy, so you only pick days and add a reason.</p>
      <div class="stats">
        <div><span>Clocked extra in ${monthLabel(currentMonth)}</span><b>${hhmm(clockedTotal)} h</b></div>
        <div><span>Applied or approved</span><b>${hhmm(used)} h</b></div>
        <div><span>Monthly cap left</span><b>${hhmm(Math.max(0, policy.monthlyCapMin - used))} h</b></div>
      </div>
      ${tabs('Employee views', empTab, [['apply', 'Apply'], ['pending', `Pending (${pending.length})`], ['history', 'History']])}
      <div class="card">${body}</div>`;
  }

  panel('employee').addEventListener('click', (ev) => {
    const t = (ev.target as HTMLElement).closest<HTMLElement>('[data-tab],[data-act]');
    if (!t) return;
    if (t.dataset.tab) { empTab = t.dataset.tab as typeof empTab; return renderEmployee(); }
    if (t.dataset.act === 'withdraw') {
      const r = requests.find((x) => x.id === Number(t.dataset.id));
      if (r) r.status = 'withdrawn';
      toast('Request withdrawn.');
      return renderEmployee();
    }
    if (t.dataset.act === 'emp-submit') {
      const p = panel('employee');
      const picked = [...p.querySelectorAll<HTMLInputElement>('input[data-date]:checked')].map((c) => c.dataset.date!);
      const remarks = (p.querySelector('#emp-remarks') as HTMLTextAreaElement).value.trim();
      if (!picked.length) return toast('Select at least one day.', true);
      if (!remarks) return toast('Remarks are required.', true);
      const items = picked.map((date) => {
        const c = clocked.find((x) => x.empId === me && x.date === date)!;
        const reason = (p.querySelector(`[data-reason="${date}"]`) as HTMLInputElement).value.trim() || remarks;
        return { date, minutes: eligibleOt(policy, c.dayType, c.extraMin).eligible, reason };
      });
      const total = items.reduce((s, i) => s + i.minutes, 0);
      if (usedThisMonth(me) + total > policy.monthlyCapMin) {
        return toast(`That's over your monthly cap of ${hhmm(policy.monthlyCapMin)} h. Pick fewer days.`, true);
      }
      items.forEach((i) => requests.push({ id: nextId++, empId: me, by: 'employee', status: 'pending', ...i }));
      toast(`Sent ${items.length} day(s), ${hhmm(total)} h, to ${managerName}. Next: step 2.`);
      empTab = 'pending';
      renderEmployee();
    }
  });

  // ---------- 2. Manager ----------
  function renderManager() {
    const p = panel('manager');
    const pending = requests.filter((r) => r.status === 'pending');
    const closed = requests.filter((r) => r.status !== 'pending' && !r.final);
    let body = '';

    if (mgrTab === 'review') {
      body = pending.length
        ? `<ul class="queue">${pending
            .map((r) => {
              const d = dayOf(r.empId, r.date);
              return `<li class="card">
                <div class="who"><b>${esc(emp(r.empId).name)}</b><small>${esc(emp(r.empId).dept)} · ${fmtDate(r.date)} · ${dayLabel(d)}</small></div>
                <div class="hrs"><b>${hhmm(r.minutes)} h</b><small>${rupees((r.minutes / 60) * hourlyRate(policy, emp(r.empId), d))}</small></div>
                <p class="why">${esc(r.reason)}</p>
                <div class="decide">
                  <input type="text" data-remarks="${r.id}" placeholder="Remarks (optional)" aria-label="Remarks for ${esc(emp(r.empId).name)}">
                  <button type="button" class="btn btn-ghost sm" data-act="reject" data-id="${r.id}">Reject</button>
                  <button type="button" class="btn btn-primary sm" data-act="approve" data-id="${r.id}">Approve</button>
                </div>
              </li>`;
            })
            .join('')}</ul>`
        : `<p class="empty card">The queue is clear. Try <b>Apply for team</b>, or go to step 3.</p>`;
    } else if (mgrTab === 'closed') {
      body = closed.length
        ? `<div class="card tbl"><table><thead><tr><th scope="col">Employee</th><th scope="col">Date</th><th scope="col">OT hours</th><th scope="col">Applied by</th><th scope="col">Status</th></tr></thead><tbody>${closed
            .map((r) => `<tr><td>${esc(emp(r.empId).name)}</td><td>${fmtDate(r.date)}</td><td>${hhmm(r.minutes)}</td><td>${r.by === 'manager' ? 'Manager' : 'Employee'}</td><td>${statusChip(r.status)}</td></tr>`)
            .join('')}</tbody></table></div>`
        : `<p class="empty card">No closed requests yet.</p>`;
    } else {
      // Running monthly total per employee so caps are checked row by row.
      const running = new Map(employees.map((e) => [e.id, usedThisMonth(e.id)]));
      const rows = clocked
        .filter((c) => monthOf(c.date) === currentMonth && !hasActive(c.empId, c.date))
        .sort((a, b) => a.empId.localeCompare(b.empId) || a.date.localeCompare(b.date))
        .map((c) => {
          const el = eligibleOt(policy, c.dayType, c.extraMin).eligible;
          if (!el) return '';
          const after = running.get(c.empId)! + el;
          const over = after > policy.monthlyCapMin;
          if (!over) running.set(c.empId, after);
          return `<tr class="${over ? 'over' : ''}">
            <td><input type="checkbox" data-team="${c.empId}|${c.date}" ${over ? 'disabled' : ''} aria-label="Select ${esc(emp(c.empId).name)}, ${fmtDate(c.date)}"></td>
            <td>${esc(emp(c.empId).name)}</td><td>${fmtDate(c.date)}</td><td>${dayLabel(c.dayType)}</td><td>${hhmm(c.extraMin)}</td>
            <td><b>${hhmm(el)}</b>${over ? '<small>Over monthly cap</small>' : ''}</td></tr>`;
        })
        .join('');
      body = rows
        ? `<div class="card"><p class="muted small">For people who don't use the app. Rows in pink would cross the ${hhmm(policy.monthlyCapMin)} h monthly cap, so they can't be applied.</p>
           <div class="tbl"><table><thead><tr><th scope="col"><input type="checkbox" data-act="all" aria-label="Select all"></th><th scope="col">Employee</th><th scope="col">Date</th><th scope="col">Day type</th><th scope="col">Clocked extra</th><th scope="col">Eligible OT</th></tr></thead><tbody>${rows}</tbody></table></div>
           <div class="actions"><button type="button" class="btn btn-primary" data-act="team-apply"><i class="ti ti-users" aria-hidden="true"></i>Apply and approve selected</button></div></div>`
        : `<p class="empty card">Every eligible day already has a request.</p>`;
    }

    p.innerHTML = `
      <p class="hint"><i class="ti ti-user-check" aria-hidden="true"></i>You're <b>${managerName}</b>, the reviewer. Approve what your team sent, or apply on behalf of people who don't use the app.</p>
      ${tabs('Manager views', mgrTab, [['review', `To review (${pending.length})`], ['closed', 'Closed'], ['team', 'Apply for team']])}
      ${body}`;
  }

  panel('manager').addEventListener('click', (ev) => {
    const t = (ev.target as HTMLElement).closest<HTMLElement>('[data-tab],[data-act]');
    if (!t) return;
    if (t.dataset.tab) { mgrTab = t.dataset.tab as typeof mgrTab; return renderManager(); }
    const act = t.dataset.act;
    if (act === 'approve' || act === 'reject') {
      const r = requests.find((x) => x.id === Number(t.dataset.id))!;
      r.status = act === 'approve' ? 'approved' : 'rejected';
      r.remarks = (panel('manager').querySelector(`[data-remarks="${r.id}"]`) as HTMLInputElement).value.trim() || undefined;
      toast(`${act === 'approve' ? 'Approved' : 'Rejected'} ${hhmm(r.minutes)} h for ${emp(r.empId).name}.`);
      return renderManager();
    }
    if (act === 'all') {
      const on = (t as HTMLInputElement).checked;
      panel('manager').querySelectorAll<HTMLInputElement>('input[data-team]:not(:disabled)').forEach((c) => (c.checked = on));
      return;
    }
    if (act === 'team-apply') {
      const picked = [...panel('manager').querySelectorAll<HTMLInputElement>('input[data-team]:checked')];
      if (!picked.length) return toast('Select at least one row.', true);
      for (const c of picked) {
        const [empId, date] = c.dataset.team!.split('|');
        const cl = clocked.find((x) => x.empId === empId && x.date === date)!;
        const minutes = eligibleOt(policy, cl.dayType, cl.extraMin).eligible;
        requests.push({ id: nextId++, empId, date, minutes, reason: 'Applied by manager', by: 'manager', status: 'approved' });
      }
      toast(`Applied and approved ${picked.length} day(s). Next: step 3.`);
      renderManager();
    }
  });

  // ---------- 3. Finalize ----------
  function line(r: OtRequest) {
    const d = dayOf(r.empId, r.date);
    const rate = hourlyRate(policy, emp(r.empId), d);
    return { d, rate, amount: (r.minutes / 60) * rate };
  }

  function renderFinalize() {
    const p = panel('finalize');
    const open = requests.filter((r) => r.status === 'approved' && !r.final);
    const paid = requests.filter((r) => r.final?.as === 'considered' && r.final.payMonth === payMonth);
    const ignored = requests.filter((r) => r.final?.as === 'ignored').length;
    const typeOf = (r: OtRequest, m: string) => (monthOf(r.date) < m ? 'arrear' : 'regular');

    const openRows = open
      .sort((a, b) => a.date.localeCompare(b.date))
      .map((r) => {
        const l = line(r);
        const type = typeOf(r, payMonth);
        return `<tr><td><input type="checkbox" data-fin="${r.id}" aria-label="Select ${esc(emp(r.empId).name)}, ${fmtDate(r.date)}"></td>
          <td>${esc(emp(r.empId).name)}</td><td>${fmtDate(r.date)}</td><td>${dayLabel(l.d)}</td><td>${hhmm(r.minutes)}</td>
          <td>${rupees(l.rate)}/h</td><td><b>${rupees(l.amount)}</b></td><td><span class="st st-${type}">${type === 'arrear' ? 'Arrear' : 'Regular'}</span></td></tr>`;
      })
      .join('');

    const reg = paid.map((r) => ({ r, ...line(r), type: typeOf(r, r.final!.payMonth!) }));
    const rev = payMonth === currentMonth ? seededReversal : null;
    const revAmount = rev ? (rev.minutes / 60) * hourlyRate(policy, emp(rev.empId), 'regular') : 0;
    const sum = (t: string) => reg.filter((x) => x.type === t).reduce((s, x) => s + x.amount, 0);
    const totalHours = reg.reduce((s, x) => s + x.r.minutes, 0) + (rev?.minutes ?? 0);
    const totalPay = reg.reduce((s, x) => s + x.amount, 0) + revAmount;

    p.innerHTML = `
      <p class="hint"><i class="ti ti-receipt" aria-hidden="true"></i>Approval says the hours were worked. Finalization decides which payroll month pays them. Hours from an earlier month become <b>arrears</b>, and hours cut after payout become <b>reversals</b>.</p>
      <div class="card">
        <div class="row fin-bar">
          <label class="field">Payroll month
            <select id="pay-month">${[currentMonth, '2026-11'].map((m) => `<option value="${m}" ${m === payMonth ? 'selected' : ''}>${monthLabel(m)}</option>`).join('')}</select>
          </label>
          <div class="actions">
            <button type="button" class="btn btn-ghost sm" data-act="ignore">Ignore</button>
            <button type="button" class="btn btn-primary sm" data-act="consider"><i class="ti ti-check" aria-hidden="true"></i>Consider for payroll</button>
          </div>
        </div>
        ${openRows
          ? `<div class="tbl"><table><thead><tr><th scope="col"><span class="visually-hidden">Select</span></th><th scope="col">Employee</th><th scope="col">Date</th><th scope="col">Day type</th><th scope="col">OT hours</th><th scope="col">Rate</th><th scope="col">Amount</th><th scope="col">Type</th></tr></thead><tbody>${openRows}</tbody></table></div>`
          : `<p class="empty">No approved overtime is waiting. ${ignored ? `${ignored} record(s) ignored.` : ''}</p>`}
      </div>

      <h2 class="reg-title">Overtime register · ${monthLabel(payMonth)}</h2>
      <div class="stats">
        <div><span>Total OT hours</span><b>${hhmm(totalHours)} h</b></div>
        <div><span>Payable</span><b>${rupees(totalPay)}</b></div>
        <div><span>Arrears</span><b>${rupees(sum('arrear'))}</b></div>
        <div><span>Reversals</span><b>${rupees(revAmount)}</b></div>
      </div>
      <div class="card tbl">
        <table><thead><tr><th scope="col">Employee</th><th scope="col">OT date</th><th scope="col">Hours</th><th scope="col">Amount</th><th scope="col">Type</th></tr></thead><tbody>
          ${reg.map((x) => `<tr><td>${esc(emp(x.r.empId).name)}</td><td>${fmtDate(x.r.date)}</td><td>${hhmm(x.r.minutes)}</td><td>${rupees(x.amount)}</td><td><span class="st st-${x.type}">${x.type === 'arrear' ? 'Arrear' : 'Regular'}</span></td></tr>`).join('')}
          ${rev ? `<tr><td>${esc(emp(rev.empId).name)}</td><td>${fmtDate(rev.date)}</td><td>${hhmm(rev.minutes)}</td><td>${rupees(revAmount)}</td><td><span class="st st-reversal">Reversal</span><small>${esc(rev.note)}</small></td></tr>` : ''}
          ${!reg.length && !rev ? '<tr><td colspan="5" class="empty">Nothing considered for this month yet.</td></tr>' : ''}
        </tbody></table>
      </div>`;
  }

  panel('finalize').addEventListener('change', (ev) => {
    const t = ev.target as HTMLElement;
    if (t.id === 'pay-month') { payMonth = (t as HTMLSelectElement).value; renderFinalize(); }
  });
  panel('finalize').addEventListener('click', (ev) => {
    const t = (ev.target as HTMLElement).closest<HTMLElement>('[data-act]');
    if (!t) return;
    const ids = [...panel('finalize').querySelectorAll<HTMLInputElement>('input[data-fin]:checked')].map((c) => Number(c.dataset.fin));
    if (!ids.length) return toast('Select at least one record.', true);
    const as = t.dataset.act === 'consider' ? 'considered' : 'ignored';
    requests.filter((r) => ids.includes(r.id)).forEach((r) => (r.final = { as, payMonth: as === 'considered' ? payMonth : undefined }));
    toast(as === 'considered' ? `${ids.length} record(s) sent to ${monthLabel(payMonth)} payroll.` : `${ids.length} record(s) ignored.`);
    renderFinalize();
  });

  renderEmployee();
</script>

<style>
  .back { margin-top: 1.5rem; }
  .demo-head { margin-block: 1rem var(--space-m); }
  .demo-head h1 { font-size: var(--step-3); }
  .demo-head .lede { max-width: 52ch; }
</style>

<style is:global>
